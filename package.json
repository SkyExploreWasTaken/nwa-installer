{
  "name": "nwa-installer",
  "version": "1.0.0",
  "description": "Install .nwa apps on a NumWorks calculator from your browser over WebUSB, without an account",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "setup": "node tools/setup.js",
    "start": "node server.js",
    "probe": "node tools/probe.mjs",
    "test": "node tools/test-numworks.mjs && node tools/check-i18n.mjs",
    "check-i18n": "node tools/check-i18n.mjs"
  },
  "devDependencies": {
    "nwlink": "^1.0.0",
    "usb": "^2.4.3"
  }
}
